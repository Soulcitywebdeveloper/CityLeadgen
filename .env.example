# Apollo.io API key — get from app.apollo.io → Settings → Integrations → API
APOLLO_API_KEY=your_apollo_api_key_here

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server config
PORT=3000
NODE_ENV=development

# Optional: restrict which origins can call this server (comma-separated)
# Leave blank to allow all origins in development
ALLOWED_ORIGINS=http://localhost:3000
